# ---------------------------------------------------------------------
# Unity
# ---------------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Never ignore .meta files for assets that ARE tracked.
# A missing .meta file makes Unity regenerate GUIDs and silently break references.
!/[Aa]ssets/**/*.meta

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Asset Store tools
/[Aa]ssets/AssetStoreTools*

# ---------------------------------------------------------------------
# IDE / solution files (regenerated by Unity)
# ---------------------------------------------------------------------
.vs/
.idea/
.vscode/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

*.pidb.meta
*.pdb.meta
*.mdb.meta

# ---------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------
*.apk
*.aab
*.app
*.unitypackage
*.ipa
sysinfo.txt
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Android auto-generated StreamingAssets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---------------------------------------------------------------------
# Project-specific
# ---------------------------------------------------------------------

# Playtest metrics — per-machine dev data, regenerated constantly, noisy in diffs.
# Delete these two lines if you ever want to pool death-heatmap data across machines.
/[Aa]ssets/[Ss]treamingAssets/levels/_metrics/
!/[Aa]ssets/[Ss]treamingAssets/levels/_metrics/.gitkeep

# Input recordings from editor rewind (regenerated, can be large)
/[Aa]ssets/[Ss]treamingAssets/levels/_replays/

# Packed level manifest — a build artefact generated from the JSON.
# The JSON in levels/ is the source of truth.
/[Aa]ssets/_Project/Generated/

# Headless test output from test.sh — results.xml and the Unity log are rewritten
# on every run. The tests are tracked; their output is not.
/[Tt]est[Rr]esults/

# ---------------------------------------------------------------------
# OS noise
# ---------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
